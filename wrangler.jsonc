// RLR · Organigrama de Gobierno 2.0 en organigrama.capitaltorreon.com — Ricardo López Reyero
// Página en sitio/ (assets) + Worker para estatus, persona, foto y currículum. Publicar: ./publicar.sh
{
  "name": "organigrama-gobierno",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./sitio", "binding": "ASSETS" },
  "routes": [{ "pattern": "organigrama.capitaltorreon.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "EDITORES": "" }, // vacío: cualquiera que entre con su cuenta puede editar; cada cambio queda en la bitácora con su correo
  "d1_databases": [{ "binding": "DB", "database_name": "organigrama-db", "database_id": "1762b483-f5be-48d9-801f-8ba58202c132" }],
  "r2_buckets": [{ "binding": "ARCHIVOS", "bucket_name": "organigrama-archivos" }]
}
